<style>
  :root {
    --bg: #0a0e1a;
    --panel: #131826;
    --panel-2: #1a2030;
    --panel-3: #222a40;
    --border: #232a3d;
    --border-2: #2d3650;
    --text: #e8ecf5;
    --text-dim: #8892a8;
    --text-muted: #5a6378;
    --gold: #d4af37;
    --gold-soft: #b89a30;
    --green: #4ade80;
    --red: #f87171;
    --bar: #6b8cc4;        /* clean clear blue */
    --bar-mode: #d4af37;
    --bar-tail-bg: #5b78b5;
    --grid: #1c2438;
    --line-over: #4ade80;
    --line-under: #f87171;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { background: var(--bg); color: var(--text); font-family: 'Fraunces', Georgia, serif; min-height: 100vh; }
  body { font-feature-settings: "ss01", "ss02"; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-feature-settings: "ss01"; }

  header {
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, #0d1220 0%, var(--bg) 100%);
    padding: 18px 28px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 16px;
  }
  .logo { display: flex; align-items: baseline; gap: 12px; }
  .logo-mark { font-size: 28px; font-weight: 700; color: var(--gold); font-style: italic; letter-spacing: -0.02em; }
  .logo-name { font-size: 20px; font-weight: 500; font-style: italic; }
  .logo-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.15em; padding-left: 12px; border-left: 1px solid var(--border); }
  .nav { display: flex; gap: 8px; }
  .nav a {
    color: var(--text-dim); text-decoration: none; padding: 7px 16px; border-radius: 18px;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.12em; border: 1px solid var(--border); transition: all 0.15s;
  }
  .nav a:hover { color: var(--text); border-color: var(--border-2); }
  .nav a.active { background: rgba(212, 175, 55, 0.1); border-color: var(--gold); color: var(--gold); }
  .meta { display: flex; gap: 20px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.1em; }
  .meta span strong { display: block; color: var(--text); font-weight: 500; font-size: 13px; margin-top: 2px; }

  .hero { padding: 32px 28px 20px; max-width: 1700px; margin: 0 auto; }
  .hero h1 { font-size: 36px; font-weight: 400; line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 12px; }
  .hero h1 em { color: var(--gold); font-style: italic; font-weight: 500; }
  .hero p { color: var(--text-dim); font-size: 14px; line-height: 1.65; max-width: 820px; margin-bottom: 8px; }
  .hero p strong { color: var(--text); font-weight: 500; }

  .legend {
    display: flex; gap: 22px; margin-top: 20px; padding: 14px 20px;
    background: var(--panel); border: 1px solid var(--border); border-radius: 4px;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; flex-wrap: wrap;
  }
  .legend-item { display: flex; align-items: center; gap: 8px; }
  .legend-swatch { width: 14px; height: 14px; border-radius: 2px; }
  .legend-swatch.bar { background: var(--bar); }
  .legend-swatch.mode { background: var(--bar-mode); }
  .legend-swatch.tail {
    background: linear-gradient(135deg, var(--bar-tail-bg) 25%, transparent 25%, transparent 50%, var(--bar-tail-bg) 50%, var(--bar-tail-bg) 75%, transparent 75%);
    background-size: 6px 6px;
  }
  .legend-line { display: none; }
  .legend-text { color: var(--text-dim); }
  .legend-text strong { color: var(--text); font-weight: 500; }

  .filters {
    padding: 18px 28px; max-width: 1700px; margin: 0 auto;
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
    border-bottom: 1px solid var(--border);
  }
  .filter-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.15em; }
  .chip {
    background: var(--panel); border: 1px solid var(--border); color: var(--text-dim);
    padding: 7px 14px; border-radius: 18px; font-family: 'JetBrains Mono', monospace;
    font-size: 11px; cursor: pointer; transition: all 0.15s; text-transform: uppercase; letter-spacing: 0.08em;
    user-select: none;
  }
  .chip:hover { border-color: var(--border-2); color: var(--text); }
  .chip.active { background: rgba(212, 175, 55, 0.1); border-color: var(--gold); color: var(--gold); }
  .chip-count { color: var(--text-muted); margin-left: 6px; font-size: 10px; }
  .chip.active .chip-count { color: var(--gold-soft); }
  .search {
    background: var(--panel); border: 1px solid var(--border); color: var(--text);
    padding: 7px 14px; border-radius: 18px; font-family: 'JetBrains Mono', monospace;
    font-size: 11px; width: 220px; margin-left: auto; outline: none;
  }
  .search:focus { border-color: var(--gold); }

  .players-grid { padding: 28px; max-width: 1700px; margin: 0 auto; }

  .player-card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 6px;
    margin-bottom: 24px; overflow: hidden;
  }
  .player-head {
    display: flex; justify-content: space-between; align-items: baseline; padding: 20px 24px;
    background: var(--panel-2); border-bottom: 1px solid var(--border); flex-wrap: wrap; gap: 12px;
  }
  .player-name {
    font-size: 24px; font-weight: 500; letter-spacing: -0.01em; line-height: 1.1;
  }
  .player-meta {
    font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--text-dim);
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .player-meta strong { color: var(--text); font-weight: 500; }

  .stats-row {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
    gap: 1px; background: var(--border);
  }
  .stat-cell {
    background: var(--panel); padding: 26px 28px;
  }
  .stat-cell-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border);
  }
  .stat-title {
    font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 600;
    color: var(--text); text-transform: uppercase; letter-spacing: 0.18em;
  }
  .stat-subtitle {
    font-family: 'JetBrains Mono', monospace; font-size: 10px;
    color: var(--text-muted); margin-top: 4px; letter-spacing: 0.1em;
  }

  .stat-summary {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
    margin-bottom: 18px; padding: 16px; background: var(--bg); border-radius: 4px;
    border: 1px solid var(--border);
  }
  .stat-summary-cell { text-align: center; }
  .stat-summary-label {
    font-family: 'JetBrains Mono', monospace; font-size: 9px; color: var(--text-dim);
    text-transform: uppercase; letter-spacing: 0.18em; margin-bottom: 6px;
  }
  .stat-summary-value {
    font-family: 'JetBrains Mono', monospace; font-size: 26px; font-weight: 600; color: var(--text);
  }

  /* — histograms — extra-clean Royce Webb-grade quality — */
  .histogram-wrap {
    margin: 4px 0 18px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 18px 14px 12px;
  }
  .histogram-svg { display: block; width: 100%; height: 320px; overflow: visible; }
  .hist-bar { fill: var(--bar); transition: opacity 0.12s; }
  .hist-bar.mode { fill: var(--bar-mode); }
  .hist-bar.tail { fill: var(--bar-tail-bg); }
  .hist-bar:hover { opacity: 0.85; }
  .hist-grid { stroke: var(--grid); stroke-width: 1; }
  .hist-grid.major { stroke: #283147; }
  .hist-axis { stroke: var(--border-2); stroke-width: 1; }
  .hist-axis-label { fill: var(--text-muted); font-family: 'JetBrains Mono', monospace; font-size: 10.5px; text-anchor: middle; }
  .hist-axis-label.tail-label { fill: var(--text-dim); font-weight: 600; }
  .hist-y-label { fill: var(--text-muted); font-family: 'JetBrains Mono', monospace; font-size: 10px; text-anchor: end; }
  .hist-axis-title { fill: var(--text-dim); font-family: 'JetBrains Mono', monospace; font-size: 10px; text-anchor: middle; letter-spacing: 0.1em; text-transform: uppercase; }

  .empty {
    padding: 80px 28px; text-align: center; color: var(--text-dim); font-style: italic;
    font-size: 14px;
  }
  .empty-pmf-data {
    padding: 14px; text-align: center; color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace; font-size: 10.5px;
    font-style: italic;
  }

  footer {
    border-top: 1px solid var(--border); padding: 24px 28px; text-align: center;
    color: var(--text-muted); font-family: 'JetBrains Mono', monospace; font-size: 11px;
    line-height: 1.7; letter-spacing: 0.05em;
  }
  footer strong { color: var(--text-dim); }

  @media (max-width: 700px) {
    .hero h1 { font-size: 28px; }
    .stats-row { grid-template-columns: 1fr; }
    .player-head { flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
