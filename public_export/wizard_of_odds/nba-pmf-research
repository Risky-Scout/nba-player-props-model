<script>
'use strict';

const STATE = {
  data: null,
  filters: { stat: 'all', search: '' },
};

const STAT_DISPLAY = {
  pts:    { label: 'Points',                      short: 'PTS' },
  reb:    { label: 'Rebounds',                    short: 'REB' },
  ast:    { label: 'Assists',                     short: 'AST' },
  fg3m:   { label: '3-Pointers',                  short: '3PM' },
  tov:    { label: 'Turnovers',                   short: 'TOV' },
  stl:    { label: 'Steals',                      short: 'STL' },
  blk:    { label: 'Blocks',                      short: 'BLK' },
  stocks: { label: 'Steals + Blocks',             short: 'STL+BLK' },
  pa:     { label: 'Points + Assists',            short: 'PTS+AST' },
  pr:     { label: 'Points + Rebounds',           short: 'PTS+REB' },
  ra:     { label: 'Rebounds + Assists',          short: 'REB+AST' },
  pra:    { label: 'Points + Rebounds + Assists', short: 'PRA' },
};

// Mission allowlist (M8.6). Twelve canonical stats when present in pmf_research.json:
// 7 base + 5 combos (incl. RA = reb+ast).
const SUPPORTED_SINGLE_STATS = new Set([
  'pts', 'reb', 'ast', 'fg3m', 'tov', 'stl', 'blk',
  'stocks', 'pa', 'pr', 'ra', 'pra'
]);

function fmtDate(s) {
  if (!s) return '—';
  return new Date(s + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
function escapeHtml(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function shortGame(game) {
  if (!game) return '';
  const teamShort = (full) => full.trim().split(' ').slice(-1)[0].slice(0, 3).toUpperCase();
  const parts = game.split(' @ ');
  if (parts.length !== 2) return game;
  return `${teamShort(parts[0])} @ ${teamShort(parts[1])}`;
}

// ── Histogram renderer — clean pure distribution, honoring the <k>+ tail bucket ──
function renderHistogram(supportPoints, mode, statShort) {
  if (!supportPoints || supportPoints.length === 0) {
    return '<div class="empty-pmf-data">No PMF data</div>';
  }

  const allPoints = supportPoints.slice();
  const tailIdx = allPoints.findIndex(p => p.is_tail);
  const hasTail = tailIdx >= 0;
  const nonTailPoints = hasTail ? allPoints.slice(0, tailIdx) : allPoints;
  const tailPoint = hasTail ? allPoints[tailIdx] : null;

  // Find max probability for y-axis scaling.
  const maxNonTail = nonTailPoints.length ? Math.max(...nonTailPoints.map(p => p.p)) : 0;
  const maxP = Math.max(maxNonTail, tailPoint ? tailPoint.p : 0);
  if (maxP <= 0) return '<div class="empty-pmf-data">No PMF data</div>';

  // Visibility threshold — bars below 0.5% of max are noise.
  const cutoff = maxP * 0.005;

  // Identify the FIRST and LAST visible non-tail k. We trim invisible bars
  // on BOTH sides so the x-axis isn't full of empty space when the model
  // emits long tails of near-zero mass.
  let firstK = null, lastVisibleK = null;
  for (const pt of nonTailPoints) {
    if (pt.p >= cutoff) {
      if (firstK === null) firstK = pt.k;
      lastVisibleK = pt.k;
    }
  }

  let displayMinK, displayMaxK, intBarCount;
  if (firstK === null) {
    // No visible non-tail bars; only the tail (if any) will render.
    displayMinK = 0;
    displayMaxK = -1;
    intBarCount = 0;
  } else {
    displayMinK = firstK;
    displayMaxK = lastVisibleK;
    intBarCount = displayMaxK - displayMinK + 1;
  }

  // Layout
  const W = 600, H = 300;
  const PAD_LEFT = 50, PAD_RIGHT = 18;
  const PAD_TOP = 20;
  const PAD_BOTTOM = 42;
  const plotW = W - PAD_LEFT - PAD_RIGHT;
  const plotH = H - PAD_TOP - PAD_BOTTOM;

  // Reserve TWO slots for the tail bucket: one empty gap slot for visual
  // separation (and to keep the last tick label from colliding with the
  // tail label), then the tail bar itself.
  const tailGapSlots = (hasTail && intBarCount > 0) ? 1 : 0;
  const tailBarSlots = hasTail ? 1 : 0;
  const totalSlots = intBarCount + tailGapSlots + tailBarSlots;
  if (totalSlots === 0) return '<div class="empty-pmf-data">No PMF data</div>';
  const slotW = plotW / totalSlots;
  const barW = Math.max(2, slotW * 0.78);

  function xCenter(slotIdx) { return PAD_LEFT + slotIdx * slotW + slotW / 2; }
  function xForK(k) { return xCenter(k - displayMinK); }
  function yScale(p) { return PAD_TOP + plotH - (p / maxP) * plotH; }

  // Y-axis: 5 horizontal gridlines + numeric percentage labels
  let grid = '';
  let yLabels = '';
  const yTicks = 5;
  for (let i = 0; i <= yTicks; i++) {
    const frac = i / yTicks;
    const yval = maxP * frac;
    const yPx = PAD_TOP + plotH - frac * plotH;
    const cls = (i === 0 || i === yTicks) ? 'hist-grid major' : 'hist-grid';
    grid += `<line class="${cls}" x1="${PAD_LEFT}" y1="${yPx.toFixed(1)}" x2="${(PAD_LEFT + plotW).toFixed(1)}" y2="${yPx.toFixed(1)}"/>`;
    yLabels += `<text class="hist-y-label" x="${(PAD_LEFT - 8).toFixed(1)}" y="${(yPx + 3.5).toFixed(1)}">${(yval * 100).toFixed(1)}%</text>`;
  }

  // Visible non-tail bars
  let bars = '';
  if (intBarCount > 0) {
    for (const point of nonTailPoints) {
      if (point.k < displayMinK || point.k > displayMaxK) continue;
      if (point.p < 1e-7) continue;
      const slotIdx = point.k - displayMinK;
      const x = xCenter(slotIdx) - barW / 2;
      const y = yScale(point.p);
      const h = (PAD_TOP + plotH) - y;
      const cls = (point.k === mode) ? 'hist-bar mode' : 'hist-bar';
      bars += `<rect class="${cls}" x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${h.toFixed(1)}" rx="1">
        <title>P(${statShort} = ${point.k}) = ${(point.p * 100).toFixed(2)}%</title>
      </rect>`;
    }
  }

  // Subtle visual separator inside the gap slot to communicate the
  // discontinuity (when the tail starts well past the last visible bar).
  // Tail buckets in your schema use `k_min` rather than `k`.
  const tailK = tailPoint ? (tailPoint.k_min ?? tailPoint.k) : null;
  let gapMarker = '';
  if (hasTail && intBarCount > 0 && tailPoint && typeof tailK === 'number' && (tailK - lastVisibleK) > 1) {
    const gapSlotIdx = intBarCount;
    const gapX = xCenter(gapSlotIdx);
    const gapY = PAD_TOP + plotH / 2 + 4;
    gapMarker = `<text class="hist-axis-label" x="${gapX.toFixed(1)}" y="${gapY.toFixed(1)}" style="opacity:0.32;font-size:14px">⋯</text>`;
  }

  // Tail bucket — ALWAYS rendered as the tail style, never gold. The tail
  // is a RANGE of k, not a single outcome; calling one "the mode" because
  // the JSON's mode happens to fall inside the range is misleading.
  let tailLabel = '';
  if (hasTail && tailPoint) {
    const tailSlotIdx = intBarCount + tailGapSlots; // slot after gap
    const x = xCenter(tailSlotIdx) - barW / 2;
    const y = yScale(tailPoint.p);
    const h = (PAD_TOP + plotH) - y;
    const tailKDisplay = (tailPoint.label || '').replace('+','') || (tailK ?? '');
    bars += `<rect class="hist-bar tail" x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${h.toFixed(1)}" rx="1">
      <title>P(${statShort} ≥ ${tailKDisplay}) = ${(tailPoint.p * 100).toFixed(2)}%</title>
    </rect>`;
    tailLabel = `<text class="hist-axis-label tail-label" x="${xCenter(tailSlotIdx).toFixed(1)}" y="${(PAD_TOP + plotH + 16).toFixed(1)}">${escapeHtml(tailPoint.label || `${tailK}+`)}</text>`;
  }

  // X-axis baseline + tick labels
  const baseY = PAD_TOP + plotH;
  let axes = `<line class="hist-axis" x1="${PAD_LEFT}" y1="${baseY}" x2="${(PAD_LEFT + plotW).toFixed(1)}" y2="${baseY}"/>`;
  let tickLabels = '';
  if (intBarCount > 0) {
    const tickStep = Math.max(1, Math.ceil(intBarCount / 10));
    for (let k = displayMinK; k <= displayMaxK; k += tickStep) {
      tickLabels += `<text class="hist-axis-label" x="${xForK(k).toFixed(1)}" y="${(baseY + 16).toFixed(1)}">${k}</text>`;
    }
    if ((displayMaxK - displayMinK) % tickStep !== 0) {
      tickLabels += `<text class="hist-axis-label" x="${xForK(displayMaxK).toFixed(1)}" y="${(baseY + 16).toFixed(1)}">${displayMaxK}</text>`;
    }
  }
  tickLabels += tailLabel;
  // X-axis title
  const xTitleY = baseY + 34;
  const xTitleX = PAD_LEFT + plotW / 2;
  tickLabels += `<text class="hist-axis-title" x="${xTitleX.toFixed(1)}" y="${xTitleY}">${escapeHtml(statShort)} (outcome k)</text>`;
  // Y-axis title
  const yTitleX = 12;
  const yTitleY = PAD_TOP + plotH / 2;
  tickLabels += `<text class="hist-axis-title" x="${yTitleX}" y="${yTitleY}" transform="rotate(-90 ${yTitleX} ${yTitleY})">Probability</text>`;

  return `<svg class="histogram-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">
    ${grid}
    ${bars}
    ${gapMarker}
    ${axes}
    ${yLabels}
    ${tickLabels}
  </svg>`;
}

// Compute summary stats from the support_points so we never display "0.0"
// just because the JSON's `mean` field was missing/zero. Mode is the
// argmax over visible (non-tail) bars; if the tail has higher mass, we
// still don't return its label because the tail is a range, not a single k.
// Tail buckets may use `k_min` instead of `k` — we accept either.
function summaryStatsFromSupport(supportPoints) {
  if (!supportPoints || supportPoints.length === 0) return { mean: null, median: null, mode: null };
  const nonTail = supportPoints.filter(p => !p.is_tail);
  const tail = supportPoints.find(p => p.is_tail) || null;
  const tailK = tail ? (tail.k_min ?? tail.k) : null;

  // Mean: sum of k * p over all support points (using tail's labeled k as
  // a lower-bound contribution for the tail mass — same as the model would).
  let mean = 0, totalP = 0;
  for (const pt of nonTail) {
    if (pt.p > 0 && typeof pt.k === 'number') {
      mean += pt.k * pt.p;
      totalP += pt.p;
    }
  }
  if (tail && typeof tailK === 'number' && tail.p > 0) {
    mean += tailK * tail.p;
    totalP += tail.p;
  }
  if (totalP > 0) mean = mean / totalP; else mean = null;

  // Median: smallest k where cumulative >= 0.5
  let median = null;
  let cum = 0;
  for (const pt of supportPoints) {
    cum += (pt.p || 0);
    if (cum >= 0.5) {
      median = pt.is_tail ? (pt.k_min ?? pt.k) : pt.k;
      break;
    }
  }

  // Mode: argmax over non-tail bars only. If tail mass is greater than
  // every non-tail bar, the mode is "in the tail" — we report the tail's
  // labeled k threshold but render it transparently.
  let mode = null, modeP = -Infinity;
  for (const pt of nonTail) {
    if ((pt.p || 0) > modeP) { modeP = pt.p; mode = pt.k; }
  }
  if (tail && (tail.p || 0) > modeP && typeof tailK === 'number') {
    mode = tailK;
  }

  return { mean, median, mode };
}

function renderStatCell(statKey, statObj) {
  const meta = STAT_DISPLAY[statKey] || { label: statKey.toUpperCase(), short: statKey.toUpperCase() };
  const support = statObj.support_points || [];

  // RESOLVE STATS FIRST — the histogram needs the resolved modeVal (not raw
  // statObj.mode) so the gold mode bar matches the value shown in the
  // summary box. Your model emits `expected_mean` not `mean`, and may omit
  // `mode` entirely; we fall back to values computed from support_points.
  const computed = summaryStatsFromSupport(support);
  const meanFromJson = (typeof statObj.expected_mean === 'number') ? statObj.expected_mean
                     : (typeof statObj.mean === 'number')          ? statObj.mean
                     : null;
  const meanVal   = (meanFromJson !== null && meanFromJson !== 0) ? meanFromJson : computed.mean;
  const medianVal = (typeof statObj.median === 'number') ? statObj.median : computed.median;
  const modeVal   = (typeof statObj.mode   === 'number') ? statObj.mode   : computed.mode;

  // Now build the histogram with the resolved mode.
  const histogram = renderHistogram(support, modeVal, meta.short);

  const meanFmt   = (meanVal   === null || meanVal   === undefined) ? '—' : Number(meanVal).toFixed(1);
  const medianFmt = (medianVal === null || medianVal === undefined) ? '—' : String(medianVal);
  const modeFmt   = (modeVal   === null || modeVal   === undefined) ? '—' : String(modeVal);

  return `<div class="stat-cell">
    <div class="stat-cell-head">
      <div>
        <div class="stat-title">${escapeHtml(meta.label)}</div>
        <div class="stat-subtitle">${support.length} support points · sums to 1.0</div>
      </div>
    </div>
    <div class="stat-summary">
      <div class="stat-summary-cell">
        <div class="stat-summary-label">Mean</div>
        <div class="stat-summary-value">${meanFmt}</div>
      </div>
      <div class="stat-summary-cell">
        <div class="stat-summary-label">Median</div>
        <div class="stat-summary-value">${medianFmt}</div>
      </div>
      <div class="stat-summary-cell">
        <div class="stat-summary-label">Mode</div>
        <div class="stat-summary-value">${modeFmt}</div>
      </div>
    </div>
    <div class="histogram-wrap">${histogram}</div>
  </div>`;
}

function renderPlayerCard(p) {
  const stats = Object.entries(p.stats || {})
    .filter(([statKey]) => SUPPORTED_SINGLE_STATS.has(String(statKey).toLowerCase()));
  if (stats.length === 0) return '';
  const order = ['pts', 'reb', 'ast', 'fg3m', 'tov', 'stl', 'blk', 'stocks', 'pa', 'pr', 'ra', 'pra'];
  stats.sort(([a], [b]) => {
    const ai = order.indexOf(a), bi = order.indexOf(b);
    return (ai < 0 ? 999 : ai) - (bi < 0 ? 999 : bi);
  });
  return `<div class="player-card">
    <div class="player-head">
      <div class="player-name">${escapeHtml(p.player)}</div>
      <div class="player-meta">${escapeHtml(shortGame(p.game))}</div>
    </div>
    <div class="stats-row">
      ${stats.map(([statKey, statObj]) => renderStatCell(statKey, statObj)).join('')}
    </div>
  </div>`;
}

function applyFilters(players) {
  const f = STATE.filters;
  let out = players;
  if (f.stat !== 'all') {
    out = out.map(p => {
      const filteredStats = {};
      if (p.stats[f.stat]) filteredStats[f.stat] = p.stats[f.stat];
      return { ...p, stats: filteredStats };
    }).filter(p => Object.keys(p.stats).length > 0);
  }
  if (f.search) {
    const q = f.search.toLowerCase();
    out = out.filter(p => (p.player || '').toLowerCase().includes(q)
                       || (p.game || '').toLowerCase().includes(q));
  }
  return out;
}

function renderStatChips(players) {
  const counts = {};
  for (const p of players) {
    for (const s of Object.keys(p.stats || {})) {
      if (!SUPPORTED_SINGLE_STATS.has(s.toLowerCase())) continue;
      counts[s] = (counts[s] || 0) + 1;
    }
  }
  const order = ['pts', 'reb', 'ast', 'fg3m', 'tov', 'stl', 'blk', 'stocks', 'pa', 'pr', 'ra', 'pra'];
  const stats = order.filter(s => counts[s]);
  const total = Object.values(counts).reduce((a, b) => a + b, 0);
  let html = `<span class="chip ${STATE.filters.stat === 'all' ? 'active' : ''}" data-stat="all">All <span class="chip-count">${total}</span></span>`;
  for (const s of stats) {
    const lbl = (STAT_DISPLAY[s] || {}).short || s.toUpperCase();
    html += `<span class="chip ${STATE.filters.stat === s ? 'active' : ''}" data-stat="${s}">${lbl} <span class="chip-count">${counts[s]}</span></span>`;
  }
  document.getElementById('stat-chips').innerHTML = html;
  document.querySelectorAll('#stat-chips .chip').forEach(el => {
    el.onclick = () => { STATE.filters.stat = el.dataset.stat; render(); };
  });
}

function render() {
  if (!STATE.data) return;
  const data = STATE.data;
  document.getElementById('slate-date').textContent = fmtDate(data.date);
  document.getElementById('player-count').textContent = (data.players || []).length;

  // Count only mission-allowed stats (anything outside the 11-stat allowlist is filtered)
  let displayedPropCount = 0;
  for (const p of data.players || []) {
    for (const s of Object.keys(p.stats || {})) {
      if (SUPPORTED_SINGLE_STATS.has(s.toLowerCase())) displayedPropCount++;
    }
  }
  document.getElementById('prop-count').textContent = displayedPropCount;

  renderStatChips(data.players || []);
  const filtered = applyFilters(data.players || []);
  const grid = document.getElementById('players-grid');
  if (filtered.length === 0) {
    grid.innerHTML = '<div class="empty">No players match the current filters.</div>';
  } else {
    grid.innerHTML = filtered.map(p => renderPlayerCard(p)).join('');
  }
}

document.getElementById('search').oninput = (e) => {
  STATE.filters.search = e.target.value;
  render();
};

function main() {
  const data = window.EMBEDDED_PMF_DATA;
  if (!data || !Array.isArray(data.players)) {
    document.getElementById('players-grid').innerHTML =
      '<div class="empty">No PMF research data embedded. Run scripts/build_woo_dashboard.py to regenerate.</div>';
    return;
  }
  STATE.data = data;
  render();
}

main();
</script>
</body>
</html>
